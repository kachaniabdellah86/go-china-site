# Public site origin used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL="https://go-china-site.vercel.app"

# Postgres connection string (Supabase). Required for /api/applications and the admin area.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Admin area (app/admin). Use a long random password; it also signs the session cookie.
ADMIN_PASSWORD=""
ADMIN_COOKIE="yalla_admin_session"
